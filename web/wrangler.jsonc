{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "advox",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "advox.ro", "custom_domain": true },
		{ "pattern": "www.advox.ro", "custom_domain": true }
	],
	// The quiz's storage (src/lib/store.ts, migrations/). Created with --jurisdiction=eu: the data
	// stays in the European Union. Local dev uses a local copy (.wrangler/state).
	"d1_databases": [
		{ "binding": "DB", "database_name": "advox", "database_id": "84652370-b963-422b-89fb-1a244e441ca9" }
	],
	// Sessions per IP per minute (see src/pages/api/session.ts). Counted per Cloudflare location.
	"ratelimits": [
		{ "name": "SESSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	],
	// Only our own console lines, no per-request logs: those would hold visitors' IPs.
	"observability": {
		"enabled": true,
		"logs": { "invocation_logs": false }
	}
}