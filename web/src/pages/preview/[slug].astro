---
// A page the editor proposed, as it stands on its branch (?branch=page/<slug>&key=<key>), before it is merged:
// every card one under another, so one picture shows them all (the redactor's preview.ts photographs
// it for the editor, and only it has the key). Not for readers: 404 without the key.
import Base from '../../layouts/Base.astro';
import PageDeck from '../../components/PageDeck.astro';
import { draftPage } from '../../lib/pages';

export const prerender = false;

const branch = Astro.url.searchParams.get('branch') ?? '';
const page = branch === `page/${Astro.params.slug}` ? await draftPage(branch, Astro.url.searchParams.get('key') ?? '') : null;
if (!page) return new Response('not found\n', { status: 404 });
---

<Base title={`Previzualizare: ${page.data.title}`} description={page.data.summary} noindex>
  <main class="deck-stack mx-auto max-w-[1440px] py-4 wide:px-8">
    <PageDeck page={page} title="h1" eager />
  </main>
</Base>

<script>
  import { wireDecks } from '../../lib/deck';
  wireDecks();
</script>
