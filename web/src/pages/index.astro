---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageDeck from '../components/PageDeck.astro';
import { allPages, questionsOf } from '../lib/pages';
import { COUNTY_TAG } from '../lib/page-progress';

// Rendered on request: the pages come from the redactor (lib/pages.ts).
export const prerender = false;

const pages = await allPages();
// "din știri" (the news pages) leads the filters, then the pages' own tags.
const NEWS = 'din știri';
const tagsOf = (s: (typeof pages)[number]) => (s.data.date ? [NEWS, ...s.data.tags] : s.data.tags);
const tags = [...new Set(pages.flatMap(tagsOf))];
const ids = (s: (typeof pages)[number], skip: string) => JSON.stringify(questionsOf(s).filter((q) => q.where !== skip).map((q) => q.id));
---

<Base
  title="advox — Cum trăiești în România?"
  description="Întrebări scurte despre viața din România, fiecare cu datele din spatele ei."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'advox',
    url: Astro.site!.href,
    inLanguage: 'ro',
    description: 'Întrebări scurte despre viața din România, fiecare cu datele din spatele ei.',
  }}
>
  {/* The questions depend on where you live: without a county and age picked in this browser, start at
      the picker. Before anything is drawn, so the page doesn't flash. Crawlers get the page as it is. */}
  <script is:inline slot="head">
    try {
      if (!localStorage.getItem('judet') || !localStorage.getItem('varsta')) location.replace('/welcome');
    } catch {}
  </script>
  <div class="flex h-dvh flex-col pt-[env(safe-area-inset-top)]">
    <SiteHeader>
      {/* What you're interested in: words searched in the pages' titles, summaries and topics, or a
          topic picked from the list under the box. */}
      <div slot="search" class="feed-search max-w-xl">
        <div class="relative">
          <svg class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" stroke-linecap="square" /></svg>
          <input id="search" type="search" autocomplete="off" placeholder="Ce te interesează?" aria-label="Caută o temă" class="h-10 w-full rounded-full border border-line bg-raised pr-4 pl-9 text-[15px] outline-none placeholder:text-dim focus:border-fg" />
        </div>
        <div id="topics" hidden class="absolute inset-x-4 top-full z-30 mt-2 flex flex-wrap gap-2 rounded-2xl border border-line bg-raised p-3 shadow-lg sm:inset-x-8" role="group" aria-label="Teme">
          {tags.map((t) => <button type="button" data-tag={t} class="tag-chip" data-county-tag={t === COUNTY_TAG ? '' : undefined}>{t === COUNTY_TAG ? 'județul tău' : t}</button>)}
        </div>
      </div>
    </SiteHeader>

    {/* The feed: one page per screen, snapping like a reel (one page per swipe on a phone; on a wide
        screen a fast scroll may pass several, still stopping on one), each page a deck of cards read sideways
        (components/PageDeck.astro). 100cqh: the feed's height. */}
    <main id="feed" class="mt-2 min-h-0 flex-1 snap-y snap-mandatory overflow-y-auto overscroll-contain [container-type:size] wide:mt-4">
      <div class="mx-auto flex w-full max-w-[1440px] flex-col wide:px-8">
        {pages.map((page, n) => (
          <article
            data-page={page.id}
            data-quiz={page.data.quiz}
            data-home={ids(page, 'diaspora')}
            data-abroad={ids(page, 'romania')}
            data-tags={JSON.stringify(tagsOf(page))}
            data-search={[page.data.title, page.data.summary, ...tagsOf(page)].join(' ')}
            data-counties={page.data.counties && JSON.stringify(page.data.counties)}
            class="page-card flex h-[100cqh] min-h-[30rem] snap-start snap-always flex-col wide:snap-normal py-3 wide:h-[100cqh] wide:pb-6"
          >
            <PageDeck page={page} href={`/p/${page.id}`} eager={n === 0} />
          </article>
        ))}
        <p class="snap-end pt-6 pb-10 wide:pt-0 text-center font-mono text-[11px] tracking-[0.18em] text-faint uppercase">Ai ajuns la capăt</p>
      </div>
    </main>
  </div>
</Base>

<script>
  import { wireDecks } from '../lib/deck';
  import { wirePages, showPeople } from '../lib/page-progress';

  wirePages();
  wireDecks();
  showPeople();

  // Up and Down (and Space, Shift+Space; Page Down, Page Up) go a page at a time, wherever the focus
  // is; Left and Right move the page's cards (deck.ts). The page in view is the one whose top is
  // nearest the feed's; pressed again while scrolling, it goes on from the page it is heading to.
  const feed = document.getElementById('feed')!;
  let heading: { to: number; until: number } | null = null;
  document.addEventListener('keydown', (e) => {
    const on = e.target as HTMLElement;
    if (e.altKey || e.ctrlKey || e.metaKey || on.closest('input, textarea, select, [contenteditable]')) return;
    const space = e.key === ' ' && !on.closest('button, a, summary');
    const d = e.key === 'ArrowDown' || e.key === 'PageDown' || (space && !e.shiftKey) ? 1 : e.key === 'ArrowUp' || e.key === 'PageUp' || (space && e.shiftKey) ? -1 : 0;
    if (!d) return;
    // In the order they're shown, not the document's: begun pages first, answered ones last (global.css).
    const top = feed.getBoundingClientRect().top;
    const shown = [...document.querySelectorAll<HTMLElement>('.page-card')].filter((c) => c.offsetParent).sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
    if (!shown.length) return;
    const near = shown.reduce((best, c, k) => (Math.abs(c.getBoundingClientRect().top - top) < Math.abs(shown[best].getBoundingClientRect().top - top) ? k : best), 0);
    const from = heading && Date.now() < heading.until ? heading.to : near;
    const to = Math.max(0, Math.min(shown.length - 1, from + d));
    e.preventDefault();
    heading = { to, until: Date.now() + 600 };
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    feed.scrollBy({ top: shown[to].getBoundingClientRect().top - top, behavior: smooth ? 'smooth' : 'auto' });
  });

  // The search: every word must be in the page's title, summary or topics, without diacritics or
  // case. A topic from the list fills the box. Back to the top, so the first match is in view.
  const plain = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
  const search = document.getElementById('search') as HTMLInputElement;
  const topics = document.getElementById('topics')!;
  const filter = () => {
    const words = plain(search.value).split(/\s+/).filter(Boolean);
    for (const card of document.querySelectorAll<HTMLElement>('.page-card')) {
      const text = plain(card.dataset.search! + ' ' + (card.querySelector('[data-county-tag]')?.textContent ?? ''));
      card.classList.toggle('hidden', !words.every((w) => text.includes(w)));
    }
    feed.scrollTo({ top: 0 });
  };
  search.addEventListener('input', filter);
  search.addEventListener('focus', () => (topics.hidden = false));
  document.addEventListener('click', (e) => !(e.target as HTMLElement).closest('.feed-search') && (topics.hidden = true));
  search.addEventListener('keydown', (e) => e.key === 'Escape' && ((topics.hidden = true), search.blur()));
  for (const chip of topics.querySelectorAll<HTMLButtonElement>('[data-tag]'))
    chip.addEventListener('click', () => {
      search.value = chip.textContent!.trim();
      topics.hidden = true;
      filter();
    });
</script>
