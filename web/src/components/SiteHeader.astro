---
// Shared by every page so the header never shifts between the landing page and the wiki: the logo,
// what the page puts in the middle (the feed's search), the theme, and a menu with the links and
// where you said you live.
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/wiki', label: 'Wiki', on: path.startsWith('/wiki') },
  { href: '/mission', label: 'Misiunea', on: path.startsWith('/mission') },
];
---

<header class="relative mx-auto flex w-full max-w-[1440px] items-center gap-3 px-4 pt-4 sm:gap-5 sm:px-8 sm:pt-6">
  <a href="/" class="-my-1 block shrink-0"><Logo class="block h-8 w-auto min-[400px]:h-9 sm:h-10" /></a>
  <div class="min-w-0 flex-1"><slot name="search" /></div>
  <ThemeToggle />
  <details class="site-menu relative -ml-3 shrink-0 sm:-ml-5">
    <summary class="press grid size-10 cursor-pointer list-none place-items-center text-dim hover:text-fg" aria-label="Meniu">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </summary>
    <nav class="absolute top-full right-0 z-30 mt-2 flex w-60 flex-col rounded-2xl border border-line bg-raised py-2 shadow-lg">
      <a href="/welcome" data-where class="px-4 py-2.5 font-mono text-[11px] tracking-[0.18em] text-dim uppercase hover:text-fg">Alege județul</a>
      {links.map((l) => (
        <a href={l.href} aria-current={l.on ? 'page' : undefined} class:list={['px-4 py-2.5 text-[13px] font-semibold tracking-[0.06em] uppercase hover:text-fg', l.on ? 'text-fg' : 'text-dim']}>{l.label}</a>
      ))}
    </nav>
  </details>
</header>

<script>
  import { AGE_KEY, COUNTY_KEY } from '../lib/page-progress';
  import { countyByCode } from '../data/counties';
  // Where you said you live, as the way to change it.
  try {
    const county = countyByCode(localStorage.getItem(COUNTY_KEY));
    const age = localStorage.getItem(AGE_KEY);
    if (county) document.querySelectorAll('[data-where]').forEach((a) => (a.textContent = [county.name, age].filter(Boolean).join(' · ')));
  } catch {}
  // The menu closes on a click outside it, or on Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.site-menu')];
  document.addEventListener('click', (e) => menus.forEach((m) => !m.contains(e.target as Node) && (m.open = false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && menus.forEach((m) => (m.open = false)));
</script>
